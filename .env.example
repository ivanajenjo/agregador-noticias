# Copia a `.env` (chmod 600) y ajusta. Compose lo lee automaticamente. Todas las variables son opcionales.
# Guia: docs/DESPLIEGUE.md

# ---------------- Imagen
# Imagen publicada por GitHub Actions. Etiquetas: latest | vX.Y.Z | sha-xxxxxxx | latest-chromium | vX.Y.Z-chromium
AGREGADOR_IMAGE=ghcr.io/ivanajenjo/agregador-noticias
AGREGADOR_TAG=latest
# Solo si compilas en la Pi con `docker compose build`: slim | chromium
AGREGADOR_TARGET=slim

# Perfiles opcionales (coma): shots (sidecar Chromium), https (Caddy). pi-install.sh --shots/--https lo rellena.
#COMPOSE_PROFILES=https

# ---------------- Red / puertos (para convivir con otros proyectos)
AGREGADOR_PORT=8080                 # puerto del host donde se publica la web
AGREGADOR_BIND=0.0.0.0              # 127.0.0.1 si solo accedes via Caddy (perfil https)
# Perfil https (Caddy): nombre con el que entras por el navegador. El de la Pi suele ser <hostname>.local
AGREGADOR_HOST=raspberrypi.local
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Subred fija de la red docker `agregador` (cambiala si choca con otra tuya). CHROME_IP debe estar dentro.
AGREGADOR_SUBNET=172.29.77.0/24
CHROME_IP=172.29.77.10

# ---------------- Identidad / usuario del contenedor
TZ=Europe/Madrid
AGREGADOR_UID=10001                 # ./data debe pertenecer a este uid (pi-install.sh lo hace)
AGREGADOR_GID=10001
AGREGADOR_LOG_LEVEL=info            # debug | info | warn | error

# ---------------- Autenticacion (HTTP basic). Vacio = sin auth. /healthz siempre abierto.
# Obligatorio si lo expones fuera de tu LAN; recomendable siempre.
AGREGADOR_AUTH_USER=
AGREGADOR_AUTH_PASS=

# ---------------- Limites de recursos (Pi compartida)
AGREGADOR_MEM_LIMIT=256m            # con imagen -chromium: 768m
AGREGADOR_CPUS=1.0
AGREGADOR_PIDS_LIMIT=256            # con imagen -chromium: 512
AGREGADOR_TMP_SIZE=256m             # /tmp en RAM (tmpfs); con -chromium: 512m
AGREGADOR_GOMEMLIMIT=96MiB          # limite blando del heap de Go; con -chromium: 128MiB
CHROME_MEM_LIMIT=768m               # solo perfil shots
CHROME_CPUS=1.5

# ---------------- Ingesta
AGREGADOR_INGEST_ENABLED=true
AGREGADOR_INGEST_CRON=*/30 * * * *

# ---------------- Capturas de portada
AGREGADOR_SCREENSHOTS_ENABLED=true
AGREGADOR_SCREENSHOTS_CRON=0 9,17,22 * * *   # hora local (TZ)
AGREGADOR_SCREENSHOTS_QUALITY=70             # JPEG 1..100
AGREGADOR_SCREENSHOTS_RETENTION=2160h        # 90 dias; las mas antiguas se borran a las 04:30
# Elige UNA forma de navegador (ninguna = la app ingiere pero no captura):
#  a) imagen -chromium (AGREGADOR_TAG=latest-chromium): no pongas nada aqui, lo lanza bajo demanda.
#  b) sidecar: `docker compose --profile shots up -d` y  AGREGADOR_SCREENSHOTS_REMOTE_URL=ws://172.29.77.10:9222
#  c) Chromium en el Mac (con --remote-debugging-address=0.0.0.0 --remote-debugging-port=9222):
#     AGREGADOR_SCREENSHOTS_REMOTE_URL=ws://192.168.1.50:9222   <- IP, NO nombre .local (Chromium rechaza Host que no sea IP)
AGREGADOR_SCREENSHOTS_REMOTE_URL=
AGREGADOR_SCREENSHOTS_NO_SANDBOX=true        # necesario con Chromium local en contenedor sin privilegios

# ---------------- LLM en el Mac/PC (API compatible OpenAI). Vacio = sin embeddings/chat (solo busqueda de texto).
# Ollama:  http://192.168.1.50:11434/v1   |  LM Studio: http://192.168.1.50:1234/v1
# USA LA IP (reserva una fija en el router) o un nombre de DNS normal/Tailscale: los contenedores NO resuelven nombres
# mDNS `.local` (macbook.local). Ver docs/DESPLIEGUE.md.
AGREGADOR_EMBEDDINGS_BASE_URL=
AGREGADOR_EMBEDDINGS_MODEL=nomic-embed-text
AGREGADOR_EMBEDDINGS_API_KEY=
# nomic-embed-text rinde mejor con prefijos (OJO al espacio final, va entre comillas). Si cambias de prefijo, reindexa.
#AGREGADOR_EMBEDDINGS_QUERY_PREFIX="search_query: "
#AGREGADOR_EMBEDDINGS_DOC_PREFIX="search_document: "
AGREGADOR_CHAT_BASE_URL=
AGREGADOR_CHAT_MODEL=qwen3:14b
AGREGADOR_CHAT_API_KEY=
